<div class="flex flex-col mt-6 xl:mt-6 mx-auto">
  <p class="text-center font-bold text-2xl xl:text-4xl mb-1 xl:mb-6"><%= t(".explicit_votings") %></p>

  <div class="container mx-auto px-4 mb-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% votings.each do |voting| %>
        <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-xl transition duration-250 flex flex-col justify-between">
          <div>
            <%= link_to voting_path(voting), class: "block mb-4" do %>
              <h5 class="text-xl font-semibold text-primary hover:underline break-words">
                <%= voting.get_translated_field("title").html_safe %>
              </h5>
            <% end %>

            <% if voting.active? %>
            <span class="inline-block bg-green-100 text-green-800 text-sm font-semibold px-3 py-1 rounded-full mb-2">
              <%= t(".active") %>
            </span>
            <% elsif voting.upcoming? %>
            <span class="inline-block bg-yellow-100 text-yellow-800 text-sm font-semibold px-3 py-1 rounded-full mb-2">
              <%= t(".upcoming") %>
            </span>
            <% else %>
            <span class="inline-block bg-red-100 text-red-800 text-sm font-semibold px-3 py-1 rounded-full mb-2">
              <%= t(".finished") %>
            </span>
            <% end %>

            <p class="text-sm text-gray-600 mb-2">
              <strong><%= t(".end_date") %></strong>
              <%= l voting.end_date, format: :long %>
            </p>

            <p class="text-sm text-gray-600 mb-4">
              <strong><%= t(".votes") %></strong>
              <% if voting.finished? %>
                <%= voting.votes.count %>
              <% else %>
                <%= t(".hidden") %>
              <% end %>
            </p>
          </div>

          <%= link_to voting_path(voting), class: "mt-auto inline-block text-sm font-medium text-primary hover:underline" do %>
            <span class="font-bold"><%= t(".details") %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex mx-auto mb-12">
    <%= paginate votings, theme: "decidim" %>
  </div>
</div>
