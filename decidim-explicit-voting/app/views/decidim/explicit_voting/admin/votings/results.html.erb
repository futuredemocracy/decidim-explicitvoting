<%
  voting = resource
  total_votes = voting.votes.count
%>

<div class="card" id="voting-results">
  <div class="card-divider">
    <h2 class="card-title">
      <%= t(".voting_results") %>
    </h2>
  </div>

  <div class="card-section space-y-4 p-4">
    <div class="voting-info">
      <p class="mb-1"><strong><%= t(".title") %>:</strong> <%= translated_attribute(voting.title) %></p>
      <p><strong><%= t(".description") %>:</strong> <%= translated_attribute(voting.description).html_safe %></p>
      <p class="mt-1 mb-1"><strong><%= t(".start_date") %>:</strong> <%= l voting.start_date, format: :long %></p>
      <p class="mb-1"><strong><%= t(".end_date") %>:</strong> <%= l voting.end_date, format: :long %></p>
      <p class="mb-1"><strong><%= t(".total_votes") %>:</strong> <%= total_votes %></p>
      <p class="mb-2"><strong><%= t(".type") %>:</strong> <%= voting.secret? ? t(".secret_yes") : t(".secret_no") %></p>

      <% if voting.active? || voting.upcoming? %>
        <div class="callout warning">
          <%= t(voting.active? ? ".still_active" : ".yet_to_come") %>
        </div>
      <% end %>
    </div>

    <h3 class="section-heading"><%= t(".results_heading") %></h3>

    <div class="table-scroll">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".option") %></th>
            <th><%= t(".votes_count") %></th>
            <th><%= t(".percentage") %></th>
          </tr>
        </thead>
        <tbody>
          <% voting.options.each do |option| %>
            <% votes_count = option.votes.count %>
            <% percent = total_votes > 0 ? (votes_count.to_f / total_votes * 100).round(2) : 0 %>
            <tr>
              <td><%= translated_attribute(option.name) %></td>
              <td><%= votes_count %></td>
              <td><%= "#{percent}%" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% unless voting.secret? %>
      <h3 class="section-heading"><%= t(".votes_list") %></h3>
      <div class="table-scroll">
        <table class="table-list">
          <thead>
            <tr>
              <th><%= t(".user") %></th>
              <th><%= t(".selected_option") %></th>
              <th><%= t(".vote_date") %></th>
            </tr>
          </thead>
          <tbody>
            <% voting.votes.includes(:user, :voting_option).each do |vote| %>
              <tr>
                <td><%= vote.user&.name || t(".unknown_user") %></td>
                <td><%= translated_attribute(vote.voting_option&.name) || t(".unknown_option") %></td>
                <td><%= l vote.created_at, format: :long %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <div class="flex justify-between">
      <%= link_to t(".export_protocol"), protocol_voting_path(voting), class: "button button__sm button__secondary" %>
      <%= link_to t(".back_to_list"), votings_path, class: "button button__sm button__secondary" %>
    </div>
  </div>
</div>
